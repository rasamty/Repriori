<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled into the compiled DLL itself, so the profile schema travels with the
         library and callers never need to ship or locate this file separately. -->
    <EmbeddedResource Include="WordFormatComparer.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project call the "internal" extractor classes in Profiling/
         directly, so each one can be unit-tested in isolation instead of only
         indirectly through WordProfileExtractor.FromDocx. Nothing outside this one
         named assembly gains access — the classes are still not part of the
         library's real public API. -->
    <InternalsVisibleTo Include="Repriori.DocProfile.Tests" />
  </ItemGroup>

</Project>
